# Copy this file to .env for local development. Never commit credentials.
# The application also works with these defaults when .env is not loaded.

APP_ENV=development

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=iotdb
# POSTGRES_USER=your-local-postgres-role
# POSTGRES_PASSWORD=your-local-postgres-password

MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=devices/temperature

ML_SERVICE_HOST=127.0.0.1
ML_SERVICE_PORT=5000
ML_MODEL_DIR=ai_worker/models
